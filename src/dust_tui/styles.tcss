$dt-surface: #11151d;
$dt-panel: #171c26;
$dt-panel-soft: #1d2430;
$dt-text: #e8edf5;
$dt-muted: #8e9aab;
$dt-accent: #71a7ff;
$dt-accent-soft: #243b61;
$dt-danger: #ff6b7a;
$dt-border: #2a3444;

Screen {
    background: $dt-surface;
    color: $dt-text;
}

Header {
    background: $dt-panel;
    color: $dt-text;
}

Footer {
    background: $dt-panel;
}

#app-shell {
    height: 1fr;
    padding: 1;
}

#scan-toolbar {
    height: 3;
    margin-bottom: 1;
}

#path-input {
    width: 1fr;
    margin-right: 1;
}

#scan-toolbar Button {
    min-width: 8;
    margin-right: 1;
}

#summary-row {
    height: 5;
    margin-bottom: 1;
}

.summary-card {
    width: 1fr;
    height: 4;
    background: $dt-panel;
    border: round $dt-border;
    padding: 0 2;
    margin-right: 1;
    content-align: left middle;
}

#summary-backend {
    margin-right: 0;
}

#usage-chart {
    height: 10;
    background: $dt-panel;
    border: round $dt-border;
    padding: 0 1;
    margin-bottom: 1;
    overflow: hidden;
}

#content-row {
    height: 1fr;
}

#results-pane {
    width: 1fr;
    min-width: 0;
    margin-right: 1;
}

#filter-row {
    height: 3;
    margin-bottom: 1;
}

#filter-input {
    width: 1fr;
    margin-right: 1;
}

#export-button {
    min-width: 8;
}

#details-button {
    min-width: 8;
    margin-right: 1;
}

#results-table {
    height: 1fr;
    background: $dt-panel;
    border: round $dt-border;
}

DataTable > .datatable--header {
    background: $dt-panel-soft;
    color: $dt-text;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $dt-accent-soft;
    color: $dt-text;
}

#details-pane {
    width: 34;
    min-width: 28;
    background: $dt-panel;
    border: round $dt-border;
    padding: 1;
}

#details-title {
    height: 2;
    color: $dt-accent;
    text-style: bold;
}

#details-body {
    height: 1fr;
    overflow-y: auto;
}

#details-actions {
    height: auto;
    dock: bottom;
    layout: grid;
    grid-size: 2;
    grid-gutter: 1;
}

#details-actions Button {
    width: 1fr;
}

#status-line {
    height: 1;
    color: $dt-muted;
    margin-top: 1;
    overflow: hidden;
}

#status-line.scanning {
    color: $dt-accent;
}

Input, Select {
    background: $dt-panel;
    border: tall $dt-border;
}

Input:focus, Select:focus {
    border: tall $dt-accent;
}

Button {
    background: $dt-panel-soft;
    color: $dt-text;
    border: none;
}

Button:hover, Button:focus {
    background: $dt-accent-soft;
}

ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.68);
}

#dialog {
    width: 64;
    max-width: 92%;
    height: auto;
    max-height: 90%;
    background: $dt-panel;
    border: round $dt-border;
    padding: 1 2;
}

#dialog.wide-dialog {
    width: 82;
}

#dialog.settings-dialog {
    overflow-y: auto;
}

#dialog.help-dialog {
    height: 20;
}

#dialog.confirm-dialog {
    width: 68;
}

#dialog.details-dialog {
    height: 24;
}

#details-dialog-body {
    height: 1fr;
    overflow-y: auto;
}

.dialog-title {
    height: 2;
    color: $dt-accent;
    text-style: bold;
}

.dialog-actions {
    height: 3;
    align-horizontal: right;
    margin-top: 1;
}

.dialog-actions Button {
    margin-left: 1;
    min-width: 12;
}

#directory-tree {
    height: 24;
    margin-top: 1;
    background: $dt-surface;
    border: round $dt-border;
}
