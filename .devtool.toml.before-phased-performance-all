[project]
kind = "python"
run_module = "dust_tui"

[execution]
environment = "auto"

[python]
manager = "auto"
test_framework = "pytest"
environment = ".devtool/venvs/python"
install_project = true
isolation = true

[targets.dustui_android]
type = "android"
root = "android"
execution_environment = "auto"

[targets.dustui_android.android]
variant = "debug"
aapt2_provider = "auto"
prefer_native_termux = false

[targets.dustui_android.gradle]
max_workers = 1
parallel = false
no_daemon = true
build_cache = true
structured_events = true

[targets.dustui_android.tasks]
build = ["assembleDebug"]
test = ["testDebugUnitTest", "lintDebug"]
lint = ["lintDebug"]
clean = ["clean"]

[targets.dustui_android.artifacts]
required = true
external_verification = "auto"

[targets.dustui_android.validation]
android_safe = true
split_gradle = true
max_workers = 1
cpu_limit = 2
parallel = false
no_daemon = true
low_priority = true
memory_guard_mb = 0
gradle_heap_mb = 768
gradle_metaspace_mb = 512
gradle_packaging_metaspace_mb = 640
gradle_lint_metaspace_mb = 512


[targets.ubuntu_provisioner]
type = "python"
root = "."
execution_environment = "auto"

[targets.ubuntu_provisioner.tasks]
test = ["pytest"]
lint = ["ruff", "check", "src", "tests"]
format_check = ["ruff", "format", "--check", "src", "tests"]
docs_check = ["ubuntu-provisioner", "docs", "check"]
build = ["python", "-m", "build", "--no-isolation"]
smoke = ["python", "-m", "ubuntu_provisioner", "--output", "json", "list"]

[targets.ubuntu_provisioner.artifacts]
required = false
external_verification = "auto"

[targets.ubuntu_provisioner.validation]
python_safe = true
low_priority = true
memory_guard_mb = 0
